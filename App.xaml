<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ProcessBoss.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProcessBoss"
    xmlns:converters="using:ProcessBoss.Converters"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#86868B"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF9F0A"/> <!-- Apple Orange -->
            <ThemeShadow x:Key="SharedShadow" />
            
            <!-- Override System Accent Color for ToggleSwitch and other controls -->
            <Color x:Key="SystemAccentColor">#FF9F0A</Color>
            <Color x:Key="SystemAccentColorLight1">#FFB340</Color>
            <Color x:Key="SystemAccentColorLight2">#FFC777</Color>
            <Color x:Key="SystemAccentColorLight3">#FFDBAE</Color>
            <Color x:Key="SystemAccentColorDark1">#CC7F08</Color>
            <Color x:Key="SystemAccentColorDark2">#995F06</Color>
            <Color x:Key="SystemAccentColorDark3">#663F04</Color>
            
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF9F0A" />
            
            <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
            <converters:PrefixConverter x:Key="PrefixConverter" />
            <converters:ProcessPriorityConverter x:Key="ProcessPriorityConverter" />
            <converters:IoPriorityConverter x:Key="IoPriorityConverter" />
            <converters:MemoryPriorityConverter x:Key="MemoryPriorityConverter" />
            <converters:GpuPriorityConverter x:Key="GpuPriorityConverter" />
            <converters:CpuAffinityConverter x:Key="CpuAffinityConverter" />
            <converters:DynamicBoostConverter x:Key="DynamicBoostConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            
            <converters:PrioritySetConverter x:Key="PrioritySetConverter" />
            <converters:IoPrioritySetConverter x:Key="IoPrioritySetConverter" />
            <converters:MemoryPrioritySetConverter x:Key="MemoryPrioritySetConverter" />
            <converters:GpuPrioritySetConverter x:Key="GpuPrioritySetConverter" />
            <converters:CpuAffinitySetConverter x:Key="CpuAffinitySetConverter" />
            <converters:DynamicBoostSetConverter x:Key="DynamicBoostSetConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
