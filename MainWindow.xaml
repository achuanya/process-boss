<Window
    x:Class="ProcessBoss.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProcessBoss"
    xmlns:models="using:ProcessBoss.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="调了么 - Process Boss">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.Resources>
            <Storyboard x:Name="MonitorBallAnimation" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="MonitorBallScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.2" Duration="0:0:0.8" />
                <DoubleAnimation Storyboard.TargetName="MonitorBallScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.2" Duration="0:0:0.8" />
            </Storyboard>
        </Grid.Resources>
        <!-- Drag Region (Title Bar) -->
        <Grid x:Name="AppTitleBar" Height="48" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="0" />

        <!-- Custom Caption Buttons & Switch -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Top" HorizontalAlignment="Right" Height="48" Canvas.ZIndex="2">
                <!-- Window Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Width="46" Height="32" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" CornerRadius="4">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#19FF9F0A" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF9F0A" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FF9F0A" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CC7F08" />
                    </Button.Resources>
                </Button>
                <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Width="46" Height="32" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" CornerRadius="4">
                    <FontIcon Glyph="&#xE922;" FontSize="10" />
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#19FF9F0A" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF9F0A" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FF9F0A" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CC7F08" />
                    </Button.Resources>
                </Button>
                <Button x:Name="CloseButton" Click="CloseButton_Click" Width="46" Height="32" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" CornerRadius="4">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CC0D1A" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <NavigationView x:Name="NavView" 
                        PaneDisplayMode="Top" 
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked"
                        Canvas.ZIndex="1"
                        Margin="0,0,0,0">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="规则列表" Tag="Rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90B;" FontSize="14"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统进程" Tag="Processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" FontSize="14"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="MonitorToggleItem" Tag="ToggleMonitor" SelectsOnInvoked="False">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- Icon Container -->
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <!-- Play Icon (Visible when stopped) -->
                                <FontIcon x:Name="MonitorPlayIcon" Glyph="&#xE768;" FontSize="14" Visibility="Visible" />
                                
                                <!-- Animated Ball (Visible when running) -->
                                <Grid x:Name="MonitorRunningIcon" Visibility="Collapsed">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="MonitorBallScale" ScaleX="1" ScaleY="1" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                            
                            <!-- Text -->
                            <TextBlock x:Name="MonitorText" Text="开始调教" VerticalAlignment="Center" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Content="添加规则" Tag="AddRule" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>