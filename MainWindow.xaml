<Window
    x:Class="SKM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SKM"
    xmlns:models="using:SKM.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SKM - 进程监控">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="添加规则" Click="AddButton_Click" />
            <AppBarButton Icon="Play" Label="启动监控" Click="StartMonitor_Click" x:Name="StartButton"/>
            <AppBarButton Icon="Stop" Label="停止监控" Click="StopMonitor_Click" IsEnabled="False" x:Name="StopButton"/>
        </CommandBar>

        <ListView x:Name="RulesListView" Grid.Row="1" ItemsSource="{x:Bind Rules}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProcessRule">
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ProcessName}" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind FullPath}" FontSize="12" Opacity="0.6" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{x:Bind Priority}" FontSize="12" />
                                <TextBlock Text="|" FontSize="12" />
                                <TextBlock Text="{x:Bind EnableEfficiencyMode}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Content="编辑" Click="EditButton_Click" Tag="{x:Bind}" />
                            <Button Content="删除" Click="DeleteButton_Click" Tag="{x:Bind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Margin="10" Text="就绪" />
    </Grid>
</Window>
