<Page
    x:Class="ProcessBoss.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Background="{ThemeResource AppBackground}">
        <ScrollViewer Padding="0,0,0,24">
            <StackPanel Margin="24,24,24,0" Spacing="24">
                
                <!-- General Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="常规设置" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" Margin="0,0,0,4"/>
                    
                    <!-- Start on Boot -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="16"
                            Background="{ThemeResource CardBackground}"
                            BorderBrush="{ThemeResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="开机自启" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="随系统启动并自动运行" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                            </StackPanel>
                            
                            <ToggleSwitch Grid.Column="1" IsOn="False" MinWidth="0" Margin="0" VerticalAlignment="Center" OffContent="关" OnContent="开" FlowDirection="RightToLeft" Foreground="{ThemeResource ToggleOnBrush}" />
                        </Grid>
                    </Border>

                    <!-- Start Minimized -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="16"
                            Background="{ThemeResource CardBackground}"
                            BorderBrush="{ThemeResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="静默启动" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="启动时不显示主窗口，仅在托盘运行" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" IsOn="False" MinWidth="0" Margin="0" VerticalAlignment="Center" OffContent="关" OnContent="开" FlowDirection="RightToLeft" Foreground="{ThemeResource ToggleOnBrush}" />
                        </Grid>
                    </Border>
                    
                    <!-- Close to Tray -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="16"
                            Background="{ThemeResource CardBackground}"
                            BorderBrush="{ThemeResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="托盘运行" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="点击关闭按钮时最小化到系统托盘" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" IsOn="True" MinWidth="0" Margin="0" VerticalAlignment="Center" OffContent="关" OnContent="开" FlowDirection="RightToLeft" Foreground="{ThemeResource ToggleOnBrush}" />
                        </Grid>
                    </Border>
                    
                    <!-- Auto Update -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="16"
                            Background="{ThemeResource CardBackground}"
                            BorderBrush="{ThemeResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="自动更新" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="自动检查并下载新版本" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" IsOn="True" MinWidth="0" Margin="0" VerticalAlignment="Center" OffContent="关" OnContent="开" FlowDirection="RightToLeft" Foreground="{ThemeResource ToggleOnBrush}" />
                        </Grid>
                    </Border>

                    <!-- Language -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="16"
                            Background="{ThemeResource CardBackground}"
                            BorderBrush="{ThemeResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="界面语言" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                <TextBlock Text="选择应用程序显示的语言" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                            </StackPanel>

                            <ComboBox Grid.Column="1" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Permissions -->
                <StackPanel Spacing="12">
                    <TextBlock Text="权限管理" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" Margin="0,0,0,4"/>

                    <!-- Run as Administrator -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="16"
                            Background="{ThemeResource CardBackground}"
                            BorderBrush="{ThemeResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="管理员权限" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" />
                                    <FontIcon Glyph="&#xE7EF;" FontSize="12" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" ToolTipService.ToolTip="User Shield" />
                                </StackPanel>
                                <TextBlock Text="获取完整权限以管理所有用户进程" Foreground="{ThemeResource TextSecondary}" FontSize="12" />
                            </StackPanel>

                            <!-- Using a Button for explicit action, or ToggleSwitch for persistent state. 
                                 Usually 'Run as Administrator' is a request. Let's use a ToggleSwitch to imply 'Always run as admin' preference. -->
                            <ToggleSwitch Grid.Column="1" IsOn="False" MinWidth="0" Margin="0" VerticalAlignment="Center" OffContent="关" OnContent="开" FlowDirection="RightToLeft" Foreground="{ThemeResource ToggleOnBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
