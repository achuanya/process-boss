<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Pure White/Silver Theme -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F3F4F6</Color> <!-- Very Light Silver App Background -->
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color> <!-- Pure White Cards -->
            <Color x:Key="CardBorderColor">#E5E7EB</Color> <!-- Silver Border -->
            
            <Color x:Key="TextPrimaryColor">#111827</Color> <!-- Almost Black for readability -->
            <Color x:Key="TextSecondaryColor">#6B7280</Color> <!-- Medium Gray/Silver Text -->
            
            <Color x:Key="AccentColor">#8E8E93</Color> <!-- Apple Silver Gray as Accent -->
            
            <!-- Window Buttons: Silver styling -->
            <Color x:Key="ButtonBackgroundHoverColor">#E5E7EB</Color>
            <Color x:Key="ButtonForegroundHoverColor">#111827</Color>
            <Color x:Key="ButtonBackgroundPressedColor">#D1D5DB</Color>
            <Color x:Key="ButtonForegroundPressedColor">#000000</Color>
            
            <Color x:Key="CloseButtonBackgroundHoverColor">#E5E7EB</Color>
            <Color x:Key="CloseButtonForegroundHoverColor">#000000</Color>
            <Color x:Key="CloseButtonBackgroundPressedColor">#D1D5DB</Color>
            <Color x:Key="CloseButtonForegroundPressedColor">#000000</Color>
            
            <!-- Tags & Badges: Silver styling -->
            <Color x:Key="RuleItemTagBackgroundColor">#F3F4F6</Color>
            
            <!-- Kill badge is now silver too, abandoning red -->
            <Color x:Key="RuleItemKillBackgroundColor">#E5E7EB</Color>
            <Color x:Key="RuleItemKillForegroundColor">#374151</Color>
            
            <!-- Hover effect over lists -->
            <Color x:Key="ListHoverColor">#0A000000</Color>

            <!-- Semantic Brushes -->
            <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
            
            <!-- Specific functional naming -->
            <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ListHoverBackground" Color="{StaticResource ListHoverColor}" />
            
            <SolidColorBrush x:Key="TitleBarButtonHoverBackground" Color="{StaticResource ButtonBackgroundHoverColor}" />
            <SolidColorBrush x:Key="TitleBarButtonHoverForeground" Color="{StaticResource ButtonForegroundHoverColor}" />
            <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="{StaticResource ButtonBackgroundPressedColor}" />
            <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="{StaticResource ButtonForegroundPressedColor}" />
            
            <SolidColorBrush x:Key="CloseButtonHoverBackground" Color="{StaticResource CloseButtonBackgroundHoverColor}" />
            <SolidColorBrush x:Key="CloseButtonHoverForeground" Color="{StaticResource CloseButtonForegroundHoverColor}" />
            <SolidColorBrush x:Key="CloseButtonPressedBackground" Color="{StaticResource CloseButtonBackgroundPressedColor}" />
            <SolidColorBrush x:Key="CloseButtonPressedForeground" Color="{StaticResource CloseButtonForegroundPressedColor}" />
            
            <SolidColorBrush x:Key="RuleItemTagBackground" Color="{StaticResource RuleItemTagBackgroundColor}" />
            <SolidColorBrush x:Key="RuleItemKillBackground" Color="{StaticResource RuleItemKillBackgroundColor}" />
            <SolidColorBrush x:Key="RuleItemKillForeground" Color="{StaticResource RuleItemKillForegroundColor}" />
        </ResourceDictionary>

        <!-- Default Theme is identical to Light to strip out any Dark Mode colors completely -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="AppBackgroundColor">#F3F4F6</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="CardBorderColor">#E5E7EB</Color>
            
            <Color x:Key="TextPrimaryColor">#111827</Color>
            <Color x:Key="TextSecondaryColor">#6B7280</Color>
            
            <Color x:Key="AccentColor">#8E8E93</Color>
            
            <Color x:Key="ButtonBackgroundHoverColor">#E5E7EB</Color>
            <Color x:Key="ButtonForegroundHoverColor">#111827</Color>
            <Color x:Key="ButtonBackgroundPressedColor">#D1D5DB</Color>
            <Color x:Key="ButtonForegroundPressedColor">#000000</Color>
            
            <Color x:Key="CloseButtonBackgroundHoverColor">#E5E7EB</Color>
            <Color x:Key="CloseButtonForegroundHoverColor">#000000</Color>
            <Color x:Key="CloseButtonBackgroundPressedColor">#D1D5DB</Color>
            <Color x:Key="CloseButtonForegroundPressedColor">#000000</Color>
            
            <Color x:Key="RuleItemTagBackgroundColor">#F3F4F6</Color>
            
            <Color x:Key="RuleItemKillBackgroundColor">#E5E7EB</Color>
            <Color x:Key="RuleItemKillForegroundColor">#374151</Color>
            
            <Color x:Key="ListHoverColor">#0A000000</Color>

            <!-- Semantic Brushes -->
            <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
            
            <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ListHoverBackground" Color="{StaticResource ListHoverColor}" />
            
            <SolidColorBrush x:Key="TitleBarButtonHoverBackground" Color="{StaticResource ButtonBackgroundHoverColor}" />
            <SolidColorBrush x:Key="TitleBarButtonHoverForeground" Color="{StaticResource ButtonForegroundHoverColor}" />
            <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="{StaticResource ButtonBackgroundPressedColor}" />
            <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="{StaticResource ButtonForegroundPressedColor}" />
            
            <SolidColorBrush x:Key="CloseButtonHoverBackground" Color="{StaticResource CloseButtonBackgroundHoverColor}" />
            <SolidColorBrush x:Key="CloseButtonHoverForeground" Color="{StaticResource CloseButtonForegroundHoverColor}" />
            <SolidColorBrush x:Key="CloseButtonPressedBackground" Color="{StaticResource CloseButtonBackgroundPressedColor}" />
            <SolidColorBrush x:Key="CloseButtonPressedForeground" Color="{StaticResource CloseButtonForegroundPressedColor}" />
            
            <SolidColorBrush x:Key="RuleItemTagBackground" Color="{StaticResource RuleItemTagBackgroundColor}" />
            <SolidColorBrush x:Key="RuleItemKillBackground" Color="{StaticResource RuleItemKillBackgroundColor}" />
            <SolidColorBrush x:Key="RuleItemKillForeground" Color="{StaticResource RuleItemKillForegroundColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared Brushes that rely on theme resources -->
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource AccentColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
</ResourceDictionary>
